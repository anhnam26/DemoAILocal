# Private server config. export APP_ENV_FILE=/etc/cyberant/cyberant.env
API_KEY=
MODEL=
# Optional numbered model slots, never auto-grant permissions to existing users.
MODEL1=
MODEL2=
MODEL3=

# Safe local default. For LAN, see README: mode=lan, server private IP and exact origin.
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8088
APP_ORIGINS=http://127.0.0.1:8088,http://localhost:8088
APP_DATA_DIR=/var/lib/cyberant
APP_BACKUP_DIR=/var/backups/cyberant
# Windows development: APP_DATA_DIR=data; APP_BACKUP_DIR=D:\CyberAnt-private\backups
# Process environment overrides this file: remove stale APP_DATA_DIR=data-v1.

# Only for explicit init of a NEW installation; remove after init.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
DEFAULT_MONTHLY_TOKENS=1000000
# UTF-8 bytes, NOT exact provider tokens. Legacy RAG_INPUT_TOKENS supported.
RAG_INPUT_BYTES=64000
# Concept/narrow/broad/multipart budgets within caps; no automatic retries.
RAG_OUTPUT_TOKENS=8000
# Hard retrieval cap also applies to service-linked evidence coverage.
RAG_TOP_K=24
# Optional administrator-confirmed limits per exact allowed model ID. No network lookup.
# Byte proxy + 1024 margin is not an exact tokenizer; provider usage is authoritative.
RAG_MODEL_LIMITS={}
API_PARALLEL=4

# OpenRouter web plugin: public lookup only; extra search charges may apply.
# Automatic lookup sends recognized public topics, never full chat/documents.
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_RESULTS=3
WEB_SEARCH_OUTPUT_TOKENS=1000