# Copy to .env on the server; do not put API keys in the Docker image.
API_KEY=
MODEL=nvidia/nemotron-3-super-120b-a12b:free
MODEL1=openai/gpt-6-luna-pro
MODEL2=qwen/qwen3.5-9b
MODEL3=deepseek/deepseek-v4.1-flash
# Numbered slots sort numerically; MODEL_4 / OPENROUTER_MODEL4 are aliases.
# Empty values are ignored and duplicate IDs appear once. Conflicting aliases
# for the same numbered slot are excluded with an admin warning.
# OPENROUTER_MODEL overrides MODEL for backward compatibility (with a warning).
# Discovery never grants permissions or changes existing account selections.
# Labels use configured slots, not automatic renumbering. Process env overrides .env.

APP_ENV=production
APP_HOST=127.0.0.1
APP_PORT=8088
APP_ORIGINS=https://knowledge.example.com
# LAN HTTP alternative (edit the values above; do not duplicate keys):
# APP_ENV=lan
# APP_HOST=0.0.0.0
# APP_PORT=8088
# APP_ORIGINS=http://192.168.1.50:8088,http://127.0.0.1:8088,http://localhost:8088
# LAN HTTP is not encrypted. Restrict the port to your trusted LAN firewall.
# Optional: absolute persistent directory outside source, owned by the app user.
# APP_DATA_DIR=/var/lib/cyberant
BOOTSTRAP_ADMIN_USERNAME=admin
# Required only when the database has no accounts. At least 14 characters.
BOOTSTRAP_ADMIN_PASSWORD=
DEFAULT_MONTHLY_TOKENS=1000000
# Input cap is a UTF-8 byte proxy, NOT exact model tokens; budgets adapt to question intent.
RAG_INPUT_BYTES=192000
# Legacy RAG_INPUT_TOKENS is also a byte proxy; use RAG_INPUT_BYTES instead.
RAG_OUTPUT_TOKENS=16000
RAG_TOP_K=48
# Authoritative operator-supplied per-model caps. Input uses a conservative byte
# proxy <= context_tokens - output_tokens - 1024; provider usage is actual tokens.
RAG_MODEL_LIMITS={}
# auto preserves supported provider defaults, excludes private reasoning traces.
# enabled/effort require a compatible model; disable for incompatible endpoints.
RAG_REASONING=auto
RAG_REASONING_EFFORT=
WEB_SEARCH_ENABLED=true
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_OUTPUT_TOKENS=1600
API_PARALLEL=4
