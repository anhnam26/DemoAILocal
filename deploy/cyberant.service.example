[Unit]
Description=CyberAnt Knowledge API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Replace all three paths/user below with your actual server values.
User=YOUR_LINUX_USER
WorkingDirectory=/opt/cyberant
ExecStart=/home/YOUR_LINUX_USER/miniconda3/envs/cyberant/bin/python /opt/cyberant/main.py
Environment=APP_ENV_FILE=/etc/cyberant/cyberant.env
# Use APP_ENV=lan, your private APP_HOST/APP_ORIGINS, and a subnet-scoped firewall.
# Point APP_ENV_FILE to the private .env you actually configured. One instance only.
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=480
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
KillMode=control-group

[Install]
WantedBy=multi-user.target
