# Optional INTERNAL HTTPS, not part of the direct LAN HTTP quickstart.
# Replace IP/name/certificate paths; clients must trust the internal certificate.
# Restrict 443/80 to the intended subnet in the server firewall, no router forwarding.
# Backend: loopback listener, APP_ENV=production, exact HTTPS APP_ORIGINS below.
server {
    listen 192.168.1.100:443 ssl;
    server_name cyberant.internal;
    ssl_certificate /etc/cyberant/tls/fullchain.pem;
    ssl_certificate_key /etc/cyberant/tls/privkey.pem;
    allow 192.168.1.0/24;
    deny all;
    # Backend keeps other endpoints <=2.1 MB; attachments alone allow 10 MB.
    client_max_body_size 11m;
    location / {
        proxy_pass http://127.0.0.1:8088;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        # Queue (180s) + total provider stage (240s) + local overhead.
        proxy_read_timeout 480s;
        proxy_connect_timeout 10s;
        # Chat uses SSE progress. Do not buffer; final content is citation-checked.
        proxy_buffering off;
    }
}
server {
    listen 192.168.1.100:80;
    server_name cyberant.internal;
    return 301 https://$host$request_uri;
}
